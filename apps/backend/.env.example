# -----------------------------------------------------------------------
# Remote Vehicle Edge Control Platform — backend env example
# Copy to .env.local and fill in secrets before starting the dev server.
# -----------------------------------------------------------------------

# PostgreSQL connection string (matches docker-compose.dev.yml defaults)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rvep?schema=public"

# JWT signing keys (RS256 — generate with: openssl genrsa 2048 | base64 -w0)
JWT_SIGNING_KEY=
JWT_REFRESH_KEY=

# LiveKit server
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# MQTT broker
MQTT_URL=mqtt://localhost:1883

# Dataset storage root (local path or MinIO/S3 bucket prefix)
STORAGE_ROOT=/var/lib/rvep/datasets

# bcrypt work factor (12 is a safe default; lower for test speed)
BCRYPT_ROUNDS=12

# Admin Onboarding v2 — invite links
INVITE_LINK_BASE_URL=http://localhost:3011/accept-invite

# Two-factor encryption (AES-256-GCM); 64 hex chars; leave empty to disable
TWO_FACTOR_ENCRYPTION_KEY=

# Audit retention
AUDIT_HOT_RETENTION_DAYS=90
AUDIT_ARCHIVE_DIR=
