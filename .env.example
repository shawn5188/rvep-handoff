# -----------------------------------------------------------------------
# Remote Vehicle Edge Control Platform — repo root env example
# Used by docker-compose.dev.yml.  Copy to .env and fill in values.
# -----------------------------------------------------------------------

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rvep

# LiveKit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# coturn TURN server
COTURN_USERNAME=rvep
COTURN_PASSWORD=rvepturnsecret
COTURN_REALM=rvep.local
